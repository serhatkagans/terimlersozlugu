# Görevli (öğretmen) paneline giriş: kullanıcı adı ve şifre
ADMIN_USER=
ADMIN_PASSWORD=
# Kartların ve üretilen resimlerin tutulacağı klasör (varsayılan: ./data)
DATA_DIR=
# Canlı yapay zekâ görseli için güvenilir görsel servisi: POST {prompt,size} -> {image_base64} (PNG)
IMAGE_SERVICE_URL=
IMAGE_SERVICE_TOKEN=
# Gemini (önerilen): cümle geri bildirimi, içerik denetimi ve görsel üretimi
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Günlük en fazla yapay zekâ görseli (maliyet koruması)
AI_DAILY_IMAGE_LIMIT=300
# Alt adreste yayın (ör. https://aiotechs.cloud/turkdili için /turkdili). Hem derlemede hem başlatmada okunur; değişince yeniden derleyin.
BASE_PATH=
